  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SignalLost.Story.CavesStory
  cavendish: {fileID: 2050703905}
  campRespawn: {fileID: 424105123}
  jobs:
  - title: Ticket to Ride
    group: {fileID: 358659693}
    bosses:
    - {fileID: 110000666}
    - {fileID: 924637381}
    - {fileID: 2042549302}
    - {fileID: 399916223}
    bossName: The Beetles
    partName: Signal Amplifier
    trophyId: beetles_elytra
    tasks:
    - {fileID: 1130609321}
    - {fileID: 661605115}
    - {fileID: 434206745}
    taskObjective: The Beetles have dropped their concert tickets all through the front of the cave. Pick them up.
    taskLabel: Tickets
    huntObjective: The Beetles are rehearsing on the ledge at the far west of the upper level. Go and catch the show.
    fightObjective: Beat the Beetles. Jump as the ring closes on a box-in; a beetle that lands on its back shows its belly.
    taskReminders:
    - West through the front of the cave, mechanic. Follow the tickets.
    - The tickets lead to the Beetles. Bands always leave a mess.
  - title: Set in Stone
    group: {fileID: 1633296164}
    bosses:
    - {fileID: 1633296163}
    bossName: The Shard Mole
    partName: Antenna Array
    trophyId: shard_mole_hide
    tasks:
    - {fileID: 1820311103}
    - {fileID: 618253881}
    - {fileID: 1690677611}
    taskObjective: The Shard Mole's digging knocked crystals loose on the deep level. Take the ramp down past the Beetles' stage, then head east and re-seat them.
    taskLabel: Crystals re-seated
    huntObjective: The Shard Mole is digging in the middle of the deep level. Go and find it.
    fightObjective: Defeat the Shard Mole. Keep quiet and it listens; keep moving when it burrows, and watch the floor for its mound.
    taskReminders:
    - Down the ramp past the Beetles' stage, then east. Put those crystals back.
    - The loose crystals lead straight to the Mole.
  - title: Bear with Me
    group: {fileID: 538674601}
    bosses:
    - {fileID: 538674599}
    bossName: The Geode Bear
    partName: Power Cell
    trophyId: geode_bear_claw
    tasks:
    - {fileID: 1064087984}
    - {fileID: 1613462653}
    - {fileID: 173196401}
    taskObjective: The Geode Bear drained the old power nodes on the deep level, east of the Mole's hollow. Restore them.
    taskLabel: Nodes restored
    huntObjective: The Geode Bear is up by the east wall of the deep level. Go and wake it properly.
    fightObjective: Defeat the Geode Bear. Look away when it yawns and stay out of reach of its swipes.
    taskReminders:
    - East of the Mole's hollow. Get those power nodes humming again.
    - Whatever you do, don't watch it yawn.
  rack:
  - {fileID: 1207484130}
  - {fileID: 1207484129}
  - {fileID: 1207484128}
  lair: {fileID: 499045448}
  chamberSignal: {fileID: 1515343390}
