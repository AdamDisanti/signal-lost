  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SignalLost.Story.DesertStory
  cavendish: {fileID: 615802989}
  player: {fileID: 139605222}
  jobs:
  - title: Picked Clean
    boss: {fileID: 738517543}
    trophyId: old_buzzard_feathers
    where: the Wreck Field, west of camp
    tasks:
    - {fileID: 460902713}
    - {fileID: 1262120074}
    - {fileID: 809717602}
    taskObjective: Old Buzzard has been moulting all over the dunes west of camp. Follow its trail and pick up the feathers.
    taskLabel: Feathers
    huntObjective: Old Buzzard roosts in the Wreck Field, west of camp. Go and find it.
    fightObjective: Defeat Old Buzzard. Step out of its shadow when it dives; knock it down with charged shots at its wings.
  - title: Burning Rubber
    boss: {fileID: 1032822388}
    trophyId: burnout_thorns
    where: the Scorch Raceway in the Mesa Pass, east of camp
    tasks:
    - {fileID: 892188515}
    - {fileID: 744815043}
    - {fileID: 327225050}
    taskObjective: Burnout set the dunes alight on its way east. Smother its fires with sand.
    taskLabel: Fires out
    huntObjective: Burnout is tearing round the Scorch Raceway in the Mesa Pass, east of camp. Go and stop it.
    fightObjective: Defeat Burnout. Sidestep late on its dashes and crash it into the pillars.
  - title: Oil and Trouble
    boss: {fileID: 729032946}
    trophyId: sludge_stinger
    where: its fuel sump, north-west of camp
    tasks:
    - {fileID: 675854113}
    - {fileID: 539551864}
    - {fileID: 1917899668}
    taskObjective: Seal the three leaking fuel lines round Sludge's sump, north-west of camp. That will bring it out.
    taskLabel: Leaks sealed
    huntObjective: Sludge has crawled out of the sump!
    fightObjective: Defeat Sludge. Get behind cover when it charges its cannon; hit its tank with a charged shot to backfire it.
  rack:
  - {fileID: 689803827}
  - {fileID: 689803826}
  - {fileID: 689803822}
  wormAmbush: {fileID: 709144719}
  lair: {fileID: 2092767074}
  wormTrophyId: core_worm_fang
