  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SignalLost.Enemies.Caves.BeetleBand
  members:
  - {fileID: 1317142669}
  - {fileID: 2084120489}
  - {fileID: 1874352189}
  - {fileID: 1351442706}
  zoneRadius: 24
  boxRadius: 6.5
  firstBoxIn: 6
  boxInInterval: 10
  intervalPerFallen: 1.8
  braceTime: 1.2
  bracePerFallen: 0.12
  gatherTimeout: 2.5
  chargeDamage: 22
  angerPerFallen: 0.15
  ringMaterial: {fileID: 2100000, guid: e396238b6385ccc4d8ac0917749b1932, type: 2}
  hearingDistance: 40
  openingLines:
  - An audience! Places, everyone!
  - Our first gig! Somebody check the mics!
  boxInLines:
  - From the top, lads! Five, six, seven, EIGHT!
  - Box formation! Like we rehearsed!
  - Big finish! Everybody in!
  - Harmonies, boys! Close ranks!
  dodgedLines:
  - OW! Who was on tempo?!
  - That's why we need a manager!
  - My SHELL! My beautiful shell!
  - Who choreographed this?!
  landedLines:
  - Nailed the landing! Encore!
  - And THAT'S how you hit the big note!
  - Did you see that? We were tight!
  memberDownLines:
  - We're down a member! The show must go on!
  - Keep playing! Keep PLAYING!
  - No! The band's breaking up!
