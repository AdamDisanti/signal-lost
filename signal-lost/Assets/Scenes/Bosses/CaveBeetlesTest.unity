  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8f4c0e2d5b3a4f9c9d7e1b2c3d4e5f72, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SignalLost.Enemies.Caves.BeetleBand
  bandName: The Beetles
  members:
  - {fileID: 384647697}
  - {fileID: 809808481}
  - {fileID: 1234920867}
  - {fileID: 1885501828}
  zoneRadius: 24
  boxRadius: 6.5
  firstBoxIn: 6
  boxInInterval: 10
  intervalPerFallen: 1.8
  braceTime: 1.2
  bracePerFallen: 0.12
  gatherTimeout: 3.5
  chargeDamage: 30
  angerPerFallen: 0.15
  ringMaterial: {fileID: 2100000, guid: e396238b6385ccc4d8ac0917749b1932, type: 2}
  calmAfterEscape: 2.5
  hearingDistance: 40
  openingLines:
  - An audience! Just like the Cavern Club! Places, everyone!
  - Our first gig since the Cavern Club! Somebody check the mics!
  boxInLines:
  - From the top, lads! Five, six, seven, EIGHT!
  - Box formation! Like we rehearsed!
  - Big finish! Everybody in!
  - Harmonies, boys! Close ranks!
  dodgedLines:
  - OW! Who was on tempo?!
  - That's why we need a manager!
  - My SHELL! My beautiful shell!
  - Who choreographed this?!
  landedLines:
  - Nailed the landing! Encore!
  - And THAT'S how you hit the big note!
  - Did you see that? We were tight!
  memberDownLines:
  - We're down a member! The show must go on!
  - Keep playing! Keep PLAYING!
  - No! The band's breaking up!
