# Repository-root Unity ignores; Unity project lives in signal-lost/.
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/signal-lost/[Ll]ibrary/
/signal-lost/[Tt]emp/
/signal-lost/[Oo]bj/
/signal-lost/[Bb]uild/
/signal-lost/[Bb]uilds/
/signal-lost/[Ll]ogs/
/signal-lost/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/signal-lost/[Mm]emoryCaptures/

# Recordings can get excessive in size
/signal-lost/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/signal-lost/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/signal-lost/ServerData
/signal-lost/[Aa]ssets/StreamingAssets/aa*
/signal-lost/[Aa]ssets/AddressableAssetsData/link.xml*
/signal-lost/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/signal-lost/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/signal-lost/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/signal-lost/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/signal-lost/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/signal-lost/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/signal-lost/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/signal-lost/UIElementsSchema/

# Auto-generated cache in Assets folder
/signal-lost/[Aa]ssets/[Ss]ceneDependencyCache*

# OS files and optional Obsidian vault settings (notes remain tracked).
.DS_Store
Thumbs.db
desktop.ini
/docs/.obsidian/
/docs/.trash/
